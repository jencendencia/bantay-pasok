{
  "appId": "com.bantaypasok.attendance",
  "productName": "Swiped Perfectly Just-in-time",
  "directories": {
    "output": "release-ia32",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "asarUnpack": [
    "node_modules/serialport/**",
    "node_modules/@serialport/**",
    "node_modules/better-sqlite3/**"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["ia32"]
      }
    ],
    "icon": "build/icon.png",
    "signAndEditExecutable": false
  },
  "publish": null,
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "runAfterFinish": true,
    "shortcutName": "Swiped Perfectly Just-in-time",
    "artifactName": "SwipedPerfectlyJustInTime.Setup.${version}.x86.${ext}"
  }
}
